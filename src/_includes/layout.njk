<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} | Motive Growth Agency</title>
  <meta name="description" content="{{ description or 'Insights on growth, ads, and inbound systems from Motive Growth Agency.' }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description or 'Insights on growth, ads, and inbound systems from Motive Growth Agency.' }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ ogImage or site.defaultOgImage }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description or 'Insights on growth, ads, and inbound systems from Motive Growth Agency.' }}" />
  <meta name="twitter:image" content="{{ ogImage or site.defaultOgImage }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background-color: #050505; color: #9ca3af; }
    .font-serif { font-family: 'Instrument Serif', serif; }
    .font-montserrat { font-family: 'Montserrat', sans-serif; }
    .glass {
      background: rgba(10, 10, 10, 0.75);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,0.08);
    }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0a0a0a; }
    ::-webkit-scrollbar-thumb { background: #222; border-radius: 3px; }
    article a { color: #fb7185; text-decoration: underline; text-decoration-color: rgba(244,63,94,0.3); }
    article a:hover { color: #fff; }
    article h2 { font-family: 'Instrument Serif', serif; color: #fff; font-size: 1.75rem; margin: 2rem 0 1rem; }
    article p { margin-bottom: 1.25rem; line-height: 1.75; }
    article ul, article ol { margin: 0 0 1.25rem 1.5rem; }
    article li { margin-bottom: 0.5rem; }
    article blockquote {
      border-left: 2px solid rgba(244,63,94,0.4);
      margin: 1.75rem 0;
      padding: 0.25rem 0 0.25rem 1.25rem;
      font-family: 'Instrument Serif', serif;
      font-style: italic;
      font-size: 1.25rem;
      color: #e5e7eb;
    }
    article blockquote footer { font-family: 'Montserrat', sans-serif; font-style: normal; font-size: 0.75rem; color: #6b7280; margin-top: 0.5rem; }
  </style>
</head>

<body class="bg-[#050505] text-gray-400 antialiased">

  <header class="fixed top-0 left-0 right-0 z-50 flex justify-center pt-4 px-4 md:pt-6 md:px-6 pointer-events-none">
    <nav class="pointer-events-auto glass flex items-center justify-between gap-4 md:gap-10 shadow-black/50 transition-all duration-300 w-full max-w-6xl rounded-full px-5 py-3 md:px-6 md:py-3.5">
      <a href="/" class="text-lg font-medium italic text-white tracking-tight font-serif shrink-0">
        Motive Growth Agency
      </a>
      <div class="hidden md:flex items-center gap-8 text-sm font-montserrat text-gray-400">
        <a href="/#why-us" class="hover:text-white transition-colors duration-200">Why Us</a>
        <a href="/#process" class="hover:text-white transition-colors duration-200">Process</a>
        <a href="/#testimonials" class="hover:text-white transition-colors duration-200">Results</a>
        <a href="/blog/" class="hover:text-white transition-colors duration-200">Blog</a>
      </div>
      <a href="/#book-call"
         class="shrink-0 bg-white text-black font-montserrat font-semibold text-sm px-5 py-2.5 rounded-full hover:bg-rose-500 hover:text-white transition-all duration-300 flex items-center gap-2 group">
        Book Free Call
        <iconify-icon icon="solar:arrow-right-linear" width="16" class="transition-transform group-hover:translate-x-0.5"></iconify-icon>
      </a>
    </nav>
  </header>

  <main class="pt-32 md:pt-40 px-4 md:px-6 max-w-3xl mx-auto pb-24">
    {{ content | safe }}
  </main>

  <footer class="border-t border-white/5 bg-[#050505] pt-12 md:pt-16 pb-8 md:pb-10 px-4 md:px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 mb-10 md:mb-12">
        <div class="max-w-xs">
          <a href="/" class="text-2xl font-medium italic text-white tracking-tight font-serif block mb-2">
            Motive Growth Agency
          </a>
          <p class="text-sm text-gray-500 leading-relaxed">
            Scaling revenue for ambitious brands through intelligent growth ecosystems.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-6 md:gap-10 text-sm font-montserrat text-gray-500">
          <div class="flex flex-col gap-2">
            <a href="/#why-us" class="hover:text-white transition-colors">Why Us</a>
            <a href="/#process" class="hover:text-white transition-colors">Process</a>
            <a href="/#testimonials" class="hover:text-white transition-colors">Results</a>
            <a href="/blog/" class="hover:text-white transition-colors">Blog</a>
          </div>
        </div>
        <a href="/#book-call"
           class="shrink-0 bg-rose-500 hover:bg-rose-400 text-white font-montserrat font-semibold text-sm px-6 py-3 rounded-full transition-all duration-300 flex items-center gap-2 group shadow-lg shadow-rose-500/20">
          Book Free Strategy Session
          <iconify-icon icon="solar:arrow-right-linear" width="16" class="transition-transform group-hover:translate-x-0.5"></iconify-icon>
        </a>
      </div>
      <div class="border-t border-white/5 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-600 font-montserrat">
        <span>&copy; 2026 Motive Growth Agency. All rights reserved.</span>
        <span class="text-gray-700">Results may vary. Past performance does not guarantee future results.</span>
      </div>
    </div>
  </footer>

</body>
</html>
